#!/usr/bin/env python3
"""PreToolUse hook: surface a file's notes before the agent edits it.

The edit-time half of enforcement — the pre-commit gate closes the loop,
this one prevents the rework. A client of the stickit CLI, not part of
it; the adopting repo copies it and wires it into its agent runtime
(see docs/hooks.md for the Claude Code settings.json snippet).

Reads the hook event on stdin, asks the board what is pinned on the
file about to be edited, and returns it as additionalContext. No notes,
no binary, no output — silence must stay free.
"""
import json
import shutil
import subprocess
import sys

TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")


def main():
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    if event.get("tool_name") not in TOOLS:
        return 0
    path = (event.get("tool_input") or {}).get("file_path") or ""
    if not path:
        return 0
    stickit = shutil.which("stickit")
    if not stickit:
        return 0
    try:
        result = subprocess.run([stickit, "ls", path], capture_output=True,
                                text=True, timeout=10)
    except subprocess.TimeoutExpired:
        return 0
    if result.returncode != 0:
        return 0
    try:
        notes = json.loads(result.stdout)
    except json.JSONDecodeError:
        return 0
    if not notes:
        return 0

    lines = ["stickit: notes already pinned on %s — read before editing:" % path]
    for n in notes:
        where = n["file"]
        if n.get("start_line"):
            where += ":%d" % n["start_line"]
        body = " ".join(n["body"].split())
        lines.append("- [%s] %s — %s (pinned by %s, resolve with %s)"
                     % (n["status"], where, body, n.get("author", "?"), n["id"]))
    lines.append("Work with these in mind; resolve a note once it is handled.")
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "additionalContext": "\n".join(lines),
        }
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
